# Copy this file to .env and fill in your own values

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=trekking_db
PGUSER=postgres
PGPASSWORD=postgres

# API server
PORT=5000

# Secret used to sign login tokens (any long random text)
TOKEN_SECRET=change-this-to-a-long-random-string

# Admin login for the staff side of the app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
